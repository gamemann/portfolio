---
import Section from "./ui/Section.astro"
import Badge from "./ui/Badge.astro"
import { skills } from "../data/skills"

// A trailing card that would otherwise sit alone on its own row spans the full
// width instead, switching to a side-by-side layout so it doesn't just read as
// a stretched version of its siblings.
const orphanIndex = skills.length % 3 === 1 ? skills.length - 1 : -1
---

<Section
    id="skillset"
    eyebrow="02 — What I do"
    title="Seven disciplines, one toolbox"
    lead="I've never been able to stay in a single lane for long, and the overlap is the point — the firewall work informs the backend work, and the support work informs all of it."
>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {skills.map((skill, i) => {
            const wide = i === orphanIndex

            return (
                <article
                    data-reveal="up"
                    style={`--reveal-delay:${(i % 3) * 90}ms`}
                    class:list={[
                        "surface glow-border group relative flex flex-col rounded-2xl p-6 transition duration-300 hover:-translate-y-1.5",
                        wide && "xl:col-span-3 xl:flex-row xl:items-start xl:gap-7"
                    ]}
                >
                    <div
                        class:list={[
                            "mb-5 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-brand-500/30 to-accent-500/15 ring-1 ring-white/10 transition duration-300 group-hover:from-brand-500/45 group-hover:to-accent-500/25",
                            wide && "xl:mb-0"
                        ]}
                    >
                        <img
                            src={skill.icon}
                            alt=""
                            width="24"
                            height="24"
                            class="h-6 w-6 opacity-85 transition duration-300 group-hover:scale-110 group-hover:opacity-100"
                        />
                    </div>

                    <div class="flex grow flex-col">
                        <h3 class="text-lg font-bold">{skill.title}</h3>

                        <p
                            class:list={[
                                "mt-3 grow text-sm leading-relaxed text-white/58 [&_a]:text-link [&_a]:underline [&_a]:decoration-brand-400/40 [&_a]:underline-offset-4 [&_a:hover]:text-link-hover",
                                wide && "xl:max-w-3xl"
                            ]}
                            set:html={skill.body}
                        />

                        <div class="mt-5 flex flex-wrap gap-1.5">
                            {skill.tags.map((tag) => <Badge>{tag}</Badge>)}
                        </div>
                    </div>
                </article>
            )
        })}
    </div>
</Section>
