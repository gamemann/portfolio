---
import Section from "./ui/Section.astro"
import Badge from "./ui/Badge.astro"
import { guideCategories, guides } from "../data/guides"
---

<Section
    id="guides"
    eyebrow="05 — Writing"
    title="Guides people actually use"
    lead="Ten-plus years of technical writing, from kernel-level networking to getting a Garry's Mod server online. Filter by topic below."
>
    <div
        data-reveal="up"
        class="mb-8 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter guides by category"
    >
        {guideCategories.map((category) => (
            <button
                type="button"
                data-filter={category}
                aria-pressed={category === "All" ? "true" : "false"}
                class="rounded-full border border-white/10 bg-white/4 px-4 py-2 text-xs font-semibold text-white/55 transition duration-200 hover:border-white/25 hover:text-white aria-pressed:border-brand-400/40 aria-pressed:bg-brand-500/20 aria-pressed:text-white"
            >
                {category}
            </button>
        ))}
    </div>

    <div id="guide-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((guide, i) => (
            <article
                data-category={guide.category}
                data-reveal="up"
                style={`--reveal-delay:${(i % 3) * 90}ms`}
                class="surface glow-border group relative flex flex-col overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-1.5"
            >
                <a
                    href={guide.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="relative block overflow-hidden"
                    tabindex="-1"
                    aria-hidden="true"
                >
                    <img
                        src={guide.banner}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="h-44 w-full object-cover brightness-[0.7] transition duration-500 group-hover:scale-[1.04] group-hover:brightness-100"
                    />
                    <div class="absolute inset-0 bg-linear-to-t from-ink-900 via-ink-900/25 to-transparent"></div>
                </a>

                <div class="flex grow flex-col p-5">
                    <div class="flex items-center gap-2">
                        <Badge tone="accent">{guide.category}</Badge>
                        <span class="font-mono text-[11px] text-white/30">{guide.source}</span>
                    </div>

                    <h3 class="mt-3 text-base leading-snug font-bold">
                        <a
                            href={guide.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="transition hover:text-brand-300"
                        >{guide.title}</a>
                    </h3>

                    <p class="mt-2 grow text-sm leading-relaxed text-white/55">{guide.summary}</p>

                    <a
                        href={guide.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex items-center gap-1.5 border-t border-white/8 pt-4 text-sm font-semibold text-white/80 transition hover:text-accent-300"
                    >
                        Read
                        <span class="transition-transform duration-200 group-hover:translate-x-0.5">↗</span>
                    </a>
                </div>
            </article>
        ))}
    </div>

    <p id="guide-empty" class="hidden py-10 text-center text-sm text-white/40">
        Nothing filed under that topic yet.
    </p>
</Section>

<script>
    // Category filter. Plain DOM so the grid stays static HTML and ships no
    // hydration cost — the buttons just toggle visibility.
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]")
    const cards = document.querySelectorAll<HTMLElement>("#guide-grid [data-category]")
    const empty = document.getElementById("guide-empty")

    for (const button of buttons) {
        button.addEventListener("click", () => {
            const wanted = button.dataset.filter

            for (const other of buttons)
                other.setAttribute("aria-pressed", String(other === button))

            let shown = 0

            for (const card of cards) {
                const match = wanted === "All" || card.dataset.category === wanted

                card.classList.toggle("hidden", !match)

                if (match)
                    shown++
            }

            empty?.classList.toggle("hidden", shown > 0)
        })
    }
</script>
