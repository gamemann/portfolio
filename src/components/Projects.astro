---
import Section from "./ui/Section.astro"
import Card from "./project/Card.astro"
import { projects } from "../data/projects"

const featured = projects.filter((p) => p.featured)
const rest = projects.filter((p) => !p.featured)
---

<Section
    id="projects"
    eyebrow="04 — Selected work"
    title="Things I've built"
    lead="A publisher, a modding community, a gaming platform and the games on it, plus a handful of tools that push packets faster than the kernel network stack normally allows."
>
    <div class="grid gap-5 md:grid-cols-2">
        {featured.map((project, i) => (
            <Card project={project} featured={true} delay={(i % 2) * 120} />
        ))}
    </div>

    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {rest.map((project, i) => (
            <Card project={project} delay={(i % 3) * 80} />
        ))}
    </div>
</Section>
