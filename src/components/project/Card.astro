---
import Badge from "../ui/Badge.astro"
import CardLinks from "../ui/CardLinks.astro"
import type { Project } from "../../data/projects"

interface Props {
    project: Project
    featured?: boolean
    delay?: number
}

const { project, featured = false, delay = 0 } = Astro.props
const banner = project.banner || "/images/project/default.png"

const chip = "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[11px] font-semibold leading-none tracking-tight shadow-sm shadow-black/40 backdrop-blur-md"

const statusTone = project.maintained
    ? "border-mint-400/35 bg-ink-950/85 text-mint-400"
    : "border-white/15 bg-ink-950/85 text-white/65"
---

<article
    data-reveal={featured ? "zoom" : "up"}
    style={`--reveal-delay:${delay}ms`}
    class:list={[
        "surface spot glow-border group flex h-full flex-col rounded-2xl transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-brand-600/20",
        featured && "ring-1 ring-brand-400/15"
    ]}
>
    <!-- Banner. The gradient behind it is what shows if the image is missing. -->
    <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="relative block aspect-[1200/630] overflow-hidden rounded-t-2xl bg-linear-to-br from-brand-700 via-ink-800 to-accent-500/40"
        tabindex="-1"
        aria-hidden="true"
    >
        <img
            src={banner}
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover brightness-90 transition duration-700 ease-out-expo group-hover:scale-[1.04] group-hover:brightness-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-ink-900/90 via-transparent to-transparent"></div>
    </a>

    {featured && (
        <span class={`absolute top-3 left-3 z-10 border-accent-400/40 bg-ink-950/85 text-accent-300 ${chip}`}>
            <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="currentColor" aria-hidden="true">
                <path d="M12 0c.9 7.2 4.8 11.1 12 12-7.2.9-11.1 4.8-12 12-.9-7.2-4.8-11.1-12-12 7.2-.9 11.1-4.8 12-12Z" />
            </svg>
            Featured
        </span>
    )}

    <span class={`absolute top-3 right-3 z-10 ${statusTone} ${chip}`}>
        {project.maintained && <span class="h-1.5 w-1.5 rounded-full bg-mint-400"></span>}
        {project.maintained ? "Maintained" : "Unmaintained"}
    </span>

    <div class:list={["flex grow flex-col", featured ? "p-5 sm:p-7" : "p-5"]}>
        <div class="flex flex-wrap items-center gap-2">
            <Badge tone="brand">{project.category}</Badge>
            {project.role && <span class="font-mono text-[11px] text-white/50">{project.role}</span>}
            {project.openSource && (
                <span class="ml-auto font-mono text-[11px] text-mint-400/80">open source</span>
            )}
        </div>

        <h3 class:list={["mt-4 flex items-center gap-3 font-bold", featured ? "text-2xl sm:text-[1.7rem]" : "text-xl"]}>
            {project.icon && (
                <img
                    src={project.icon}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                    class:list={["shrink-0 rounded-lg ring-1 ring-white/15", featured ? "h-10 w-10" : "h-8 w-8"]}
                />
            )}
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="transition hover:text-brand-300">
                {project.title}
            </a>
        </h3>

        <p class:list={["mt-3 grow leading-relaxed text-white/65", featured ? "text-[15px]" : "text-sm"]}>{project.summary}</p>

        <div class="mt-5 flex flex-wrap gap-1.5">
            {project.tags.map((tag) => <Badge>{tag}</Badge>)}
        </div>

        <CardLinks
            title={project.title}
            link={project.link}
            sourceLink={project.openSource ? project.sourceLink : undefined}
            class="mt-5 border-t border-white/8 pt-5"
        />
    </div>
</article>
