---
import Section from "./ui/Section.astro"
import StackView from "./react/Stack"
import { stackGroups, stackItems } from "../data/stack"
---

<Section
    id="stack"
    eyebrow="03 — What I build with"
    title="My stack"
    lead="Ranked by how much time I've actually spent in each. The orbit puts the deepest mileage closest to the centre; the grid says the same thing as a plain list."
>
    <div data-reveal="fade">
        <StackView client:visible items={stackItems} groups={stackGroups} />
    </div>
</Section>
