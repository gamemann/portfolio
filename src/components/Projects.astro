---
import Section from "./ui/Section.astro"
import Card from "./project/Card.astro"
import { projects } from "../data/projects"

const featured = projects.filter((p) => p.featured)
const rest = projects.filter((p) => !p.featured)
---

<Section
    id="projects"
    eyebrow="04 — Selected work"
    title="Things I've built"
    lead="A publisher, a modding platform, and a handful of tools that push packets faster than the kernel network stack normally allows."
>
    <div class="grid gap-4 lg:grid-cols-2">
        {featured.map((project, i) => (
            <Card project={project} featured={true} delay={i * 120} />
        ))}
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {rest.map((project, i) => (
            <Card project={project} delay={(i % 4) * 80} />
        ))}
    </div>
</Section>
